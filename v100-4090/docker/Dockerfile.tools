# Python tools for preparing the weights (download from Hugging Face, Q8_0 GGUF reader, tensor-parallel sharding),
# kept off the host system: CPU-only torch + numpy + gguf + safetensors + the Hugging Face CLI, and pytest for the
# Python test suite (scripts/test.sh python).
#
#   docker build -f v100-4090/docker/Dockerfile.tools -t ninfer-v100-4090/tools v100-4090/docker
FROM python:3.12-slim
RUN pip install --no-cache-dir numpy torch --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple
RUN pip install --no-cache-dir gguf safetensors "huggingface_hub[cli]" pytest
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /src
