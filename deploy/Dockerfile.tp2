# Runtime image for the two-GPU (TP2) service. Build the binaries first (see README), then:
#   docker build -f deploy/Dockerfile.tp2 -t ninfer-v100:tpx .
# BASE must already contain the CUDA 12.8 runtime libraries the ninfer binaries were linked against.
ARG BASE=ninfer-v100-base:latest
FROM ${BASE}
COPY build-v100/apps/ninfer-serve /usr/local/bin/ninfer-serve
COPY tools/tp2/tp2_proxy.py /usr/local/bin/tp2_proxy.py
# libnccl.so.2 with sm_70 kernels (from the nvidia-nccl-cu12==2.21.5 wheel) and the matching libcudart.
COPY deploy/lib/libnccl.so.2 /usr/local/lib/ninfer-cuda/libnccl.so.2
COPY deploy/lib/libcudart.so.12 /usr/local/lib/ninfer-cuda/libcudart.so.12
ENV LD_LIBRARY_PATH=/usr/local/lib/ninfer-cuda
EXPOSE 8080
STOPSIGNAL SIGTERM
CMD ["python3", "/usr/local/bin/tp2_proxy.py", "--help"]
